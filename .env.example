# Application
PROJECT_NAME="Bodhrik Fullstack Assessment API"
DEBUG=true

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bodhrik
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bodhrik

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Security / JWT
JWT_SECRET_KEY=change-this-to-a-secure-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Background Jobs & Notifications
BACKGROUND_JOBS_ENABLED=true
BOOKING_REMINDER_MINUTES=30
BACKGROUND_JOB_INTERVAL_MINUTES=5

# CORS Security Configuration (comma-separated origins or JSON array)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8000"

